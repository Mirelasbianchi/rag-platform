DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
# local/hashing runs offline with no API key; or use any LiteLLM model,
# e.g. openai/text-embedding-3-small (needs OPENAI_API_KEY)
EMBEDDING_MODEL=local/hashing
EMBEDDING_DIM=1536
OPENAI_API_KEY=
CHUNK_SIZE=800
CHUNK_OVERLAP=100
# Model for /ask (any LiteLLM model). Leave empty for offline extractive answers.
LLM_MODEL=
ANTHROPIC_API_KEY=
